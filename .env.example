# ==============================================================================
# AI YouTube Automation Platform - Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env to Git.
# ==============================================================================

# ---------- App ----------
APP_ENV=development           # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-64-char-string
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Frontend (Phase 10) ----------
# Baked into the frontend's production build at `docker compose build` time
# (Vite inlines VITE_* vars — see frontend/Dockerfile) and read live by the
# dev server. Change this if the browser loading the frontend can't reach
# the backend at localhost:8000 (e.g. it's on another host).
VITE_API_BASE_URL=http://localhost:8000

# ---------- Database ----------
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/ai_youtube_automation

# ---------- Redis / Celery ----------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---------- LLM Provider ----------
# One of: openai | groq | gemini
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---------- Visual Generation Provider ----------
# One of: openai_images | stock | local_placeholder
VISUAL_PROVIDER=openai_images
STOCK_IMAGE_API_KEY=

# ---------- TTS Provider ----------
# One of: edge_tts | elevenlabs | openai_tts
TTS_PROVIDER=edge_tts
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
TTS_DEFAULT_VOICE=en-US-JennyNeural
TTS_DEFAULT_LANGUAGE=en-US

# ---------- YouTube (OAuth 2.0 - Data API v3) ----------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/youtube/oauth/callback
YOUTUBE_DEFAULT_PRIVACY_STATUS=private   # private | unlisted | public
YOUTUBE_AUTO_PUBLISH=false               # must be explicitly enabled by the user

# ---------- Storage ----------
# One of: local | s3
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-1

# ---------- Notifications (optional) ----------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- n8n (Phase 14, optional) ----------
# Inbound: shared secret an n8n workflow sends as X-Webhook-Secret when it
# calls POST /api/webhooks/n8n/trigger to start a new video. Leave blank
# for local-only testing (a warning is logged on every call instead).
N8N_INBOUND_WEBHOOK_SECRET=
# Outbound: the n8n Webhook-node URL this backend calls when a pipeline
# finishes/fails or a YouTube upload succeeds/fails. Leave blank to disable
# outbound notifications entirely.
N8N_OUTBOUND_WEBHOOK_URL=
N8N_OUTBOUND_WEBHOOK_SECRET=

# ---------- n8n container settings (only used by the `n8n` service itself) ----------
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_HOST=localhost
N8N_PUBLIC_WEBHOOK_URL=http://localhost:5678/
N8N_TIMEZONE=UTC

# ---------- Retry / Job Config ----------
MAX_RETRIES=3
RETRY_BACKOFF_BASE_SECONDS=2
